DATABASE_HOST="localhost"
DATABASE_PORT="3306"
DATABASE_USER="user-example"
DATABASE_PASSWORD="password-example"
DATABASE_NAME="name-example"
JWT_SECRET="example"
NODE_ENV="development"
SMTP_HOST="mail.smtp2go.com"
SMTP_PORT="465"
SMTP_USER="example@example.com"
SMTP_PASS="example"
SMTP_FROM="email@email.com"

# URL publique de l'application (utilisée par le cron des rappels)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Secret partagé entre le cron et /api/reservation/send-reminders
CRON_SECRET="example-cron-secret"
# Fréquence du cron des rappels (défaut : chaque minute)
CRON_SCHEDULE="*/1 * * * *"

# Dossier des images téléversées (volume persistant en production)
UPLOADS_DIR="./uploads"
# Fuseau horaire de l'application (doit correspondre au serveur MySQL)
TZ="America/Toronto"

# IGDB : identifiants d'application Twitch (console dev Twitch).
# Sans eux, la recherche de jaquettes est desactivee ; le depot de
# fichier et l'import par lien direct continuent de fonctionner.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

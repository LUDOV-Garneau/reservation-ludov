          "type": "bigint",
          "primaryKey": false,
          "notNull": true,
          "autoincrement": false
        },
        "active_units": {
          "name": "active_units",
          "type": "decimal(23,0)",
          "primaryKey": false,
          "notNull": false,
          "autoincrement": false
        },
        "inactive_units": {
          "name": "inactive_units",
          "type": "decimal(23,0)",
          "primaryKey": false,
          "notNull": false,
          "autoincrement": false
        }
      },
      "name": "console_catalog",
      "isExisting": false,
      "definition": "select `ct`.`id` AS `console_type_id`,`ct`.`name` AS `name`,`ct`.`picture` AS `picture`,`ct`.`description` AS `description`,count(`cs`.`id`) AS `total_units`,sum((case when ((`cs`.`is_active` = 1) and (`cs`.`holding` = 0)) then 1 else 0 end)) AS `active_units`,sum((case when (`cs`.`is_active` = 0) then 1 else 0 end)) AS `inactive_units` from (`ludov_dev`.`console_type` `ct` left join `ludov_dev`.`console_stock` `cs` on((`ct`.`id` = `cs`.`console_type_id`))) where exists(select 1 from `ludov_dev`.`stations` `s` where json_contains(`s`.`consoles`,cast(`ct`.`id` as json),'$')) group by `ct`.`id`,`ct`.`name` order by `ct`.`name`",
      "algorithm": "undefined",
      "sqlSecurity": "definer"
    }
  },
